#!/usr/bin/env python3
"""Export a standalone, project-agnostic AI workspace with synthetic demo data."""

from __future__ import annotations

import datetime as dt
import json
import shutil
import sys
from pathlib import Path

from workspace_lib import WORKSPACE


arguments = [value for value in sys.argv[1:] if not value.startswith("--")]
force = "--force" in sys.argv[1:]
destination = Path(arguments[0]).expanduser().resolve() if arguments else WORKSPACE / "dist/team-kit"
if destination in {Path("/"), Path.home().resolve(), WORKSPACE.resolve()}:
    raise SystemExit(f"ERROR unsafe export destination: {destination}")
if destination.exists() and not force:
    raise SystemExit(f"ERROR {destination} exists; pass --force to replace it")


def write(relative: str, content: str, *, executable: bool = False) -> None:
    path = destination / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    if executable:
        path.chmod(0o755)


def note(
    relative: str,
    *,
    name: str,
    description: str,
    metadata_type: str,
    note_type: str,
    domain: str,
    repos: list[str],
    heading: str,
    body: str,
    source: str,
    role: str | None = None,
) -> None:
    repo_lines = "[]" if not repos else "\n" + "\n".join(f"  - {value}" for value in repos)
    role_line = f"role: {json.dumps(role, ensure_ascii=False)}\n" if role is not None else ""
    write(
        relative,
        f"""---
name: {name}
description: {json.dumps(description, ensure_ascii=False)}
metadata:
  type: {metadata_type}
type: {note_type}
domain: {domain}
{role_line}repos: {repo_lines}
status: active
verified: true
updated: {today}
sources:
  - {source}
---

# {heading}

{body.rstrip()}
""",
    )


if destination.exists():
    shutil.rmtree(destination)
destination.mkdir(parents=True)

shutil.copytree(WORKSPACE / ".ai/skills", destination / ".ai/skills")
shutil.copytree(WORKSPACE / ".ai/rules", destination / ".ai/rules")
shutil.copytree(WORKSPACE / ".ai/templates", destination / ".ai/templates")
shutil.copytree(WORKSPACE / "global", destination / "global")
(destination / "scripts").mkdir()
for name in GENERIC_SCRIPTS:
    source = WORKSPACE / "scripts" / name
    if source.is_file():
        shutil.copy2(source, destination / "scripts" / name)

(destination / ".claude").mkdir()
shutil.copy2(WORKSPACE / ".claude/settings.json", destination / ".claude/settings.json")
(destination / "bin").mkdir()
shutil.copy2(WORKSPACE / "bin/aiw", destination / "bin/aiw")
write("VERSION", "0.2.0\n")

for folder in MEMORY_SKELETON:

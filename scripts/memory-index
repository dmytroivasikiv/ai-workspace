#!/usr/bin/env python3
"""Lint memory, rebuild the shared index, and refresh the workspace-local lexical index.

The index lists global notes in full, counts the company roster once, and summarises project
folders by count instead of by note. That keeps the always-loaded surface flat as the vault grows:
colleague and project notes reach the model through the session hook and `scripts/memory-search`.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path
from workspace_lib import WORKSPACE, projects, qmd

MEMORY = WORKSPACE / "memory"
INDEX = MEMORY / "MEMORY.md"
GLOBAL_FOLDERS = ("00-profile", "10-workspace", "40-patterns")
HEADER = """# Memory index

Global notes below apply to every task and are listed in full. Project knowledge is not listed
here: the session hook surfaces the notes matching your prompt, and `scripts/memory-search
<project> <terms>` is the real search. Never load the vault wholesale.

Generated by `scripts/memory-index`. One line per global note, one company count, one line per project."""


def field(text: str, key: str) -> str:
    match = re.search(rf"^{key}:\s*(.+?)\s*$", text, re.MULTILINE)
    return match.group(1).strip("'\"") if match else ""


def title_of(path: Path, head: str) -> str:
    name = field(head, "name")
    if name:
        return name
    heading = re.search(r"^#\s+(.+?)\s*$", head, re.MULTILINE)
    if heading:
        return heading.group(1).strip()
    if path.stem == "project":
        return f"{path.parent.name} project"
    return path.stem


def notes_in(folder: Path) -> list[Path]:
    return sorted(folder.glob("*.md")) if folder.is_dir() else []


subprocess.run([str(WORKSPACE / "scripts/memory-normalize"), "--apply"], cwd=WORKSPACE, check=False)
lint = subprocess.run([str(WORKSPACE / "scripts/memory-lint")], cwd=WORKSPACE, check=False)
if lint.returncode:
    raise SystemExit(lint.returncode)

lines = [HEADER, "", "## Global"]
global_count = 0
for folder in GLOBAL_FOLDERS:
    for path in notes_in(MEMORY / folder):
        head = path.read_text(errors="replace")[:2000]
        title = title_of(path, head)
        hook = field(head, "description")
        relative = path.relative_to(MEMORY)
        lines.append(f"- [{title}]({relative})" + (f" — {hook}" if hook else ""))
        global_count += 1

colleagues = notes_in(MEMORY / "15-colleagues")
lines += ["", "## Company"]
lines.append(f"- **colleagues** — {len(colleagues)} verified profile(s) — `memory/15-colleagues/`")

lines += ["", "## Projects"]
project_count = 0
for row in projects():
    facts = notes_in(MEMORY / "20-projects" / row["id"])
    anchors = notes_in(MEMORY / "30-tasks" / row["id"])
    if not facts and not anchors:
        continue
    project_count += 1
    def plural(count: int, word: str) -> str:
        return f"{count} {word}" + ("" if count == 1 else "s")

    lines.append(
        f"- **{row['id']}** — {plural(len(facts), 'project note')},"
        f" {plural(len(anchors), 'task anchor')}"
        f" — `memory/20-projects/{row['id']}/`, `memory/30-tasks/{row['id']}/`"
    )

INDEX.write_text("\n".join(lines) + "\n")
print(f"OK   memory index ({global_count} global note(s), {len(colleagues)} colleague(s), {project_count} project(s))")

result = qmd("update", timeout=120)
if result.stdout:
    print(result.stdout, end="")
if result.stderr:
    print(result.stderr, end="", file=sys.stderr)
if result.returncode == 0:
    marker = WORKSPACE / ".qmd/last-index"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.touch()
raise SystemExit(result.returncode)

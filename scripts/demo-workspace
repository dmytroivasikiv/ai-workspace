#!/usr/bin/env python3
"""Run a compact, read-only demonstration of routing, retrieval, and graph policy."""

from __future__ import annotations

import json
import subprocess
import uuid

from workspace_lib import WORKSPACE


def section(title: str, command: list[str], *, input_text: str | None = None) -> None:
    print(f"\n=== {title} ===")
    result = subprocess.run(
        command,
        cwd=WORKSPACE,
        input=input_text,
        text=True,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    print(result.stdout.strip() or f"exit {result.returncode}")


if not (WORKSPACE / "workspace.yaml").is_file():
    raise SystemExit("Run ./bin/aiw setup first")

section("1. Isolated projects", [str(WORKSPACE / "scripts/workspace-status")])

payload = json.dumps(
    {
        "session_id": str(uuid.uuid4()),
        "hook_event_name": "UserPromptSubmit",
        "cwd": str(WORKSPACE),
        "prompt": "shop trace the order summary contract",
    }
)
section(
    "2. Claude project card from a prompt",
    ["node", str(WORKSPACE / "scripts/claude-hook.mjs")],
    input_text=payload,
)
section(
    "3. Scoped memory retrieval",
    [str(WORKSPACE / "scripts/memory-search"), "shop", "order summary contract"],
)

isolation = subprocess.run(
    [str(WORKSPACE / "scripts/memory-search"), "support", "order summary contract"],
    cwd=WORKSPACE,
    text=True,
    check=False,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
)
print("\n=== 4. Cross-project isolation ===")
if "memory/20-projects/shop/" in isolation.stdout:
    raise SystemExit("ERROR shop memory leaked into the support scope")
print("No Shop project memory surfaced while searching in Support.")

section(
    "5. Bounded task context",
    [str(WORKSPACE / "scripts/task-context"), "shop", "order summary contract"],
)
section(
    "6. On-demand code graph",
    [str(WORKSPACE / "scripts/code-graph"), "status", "shop-api"],
)
print("\nThe graph is intentionally not built until a structural question justifies it.")
